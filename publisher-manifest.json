ckground:var(--wash);width:150px}\n  table.plans td.pick{background:#fff6f0}\n  .tag{display:inline-block;font-size:11px;letter-spacing:.14em;background:var(--ink);color:#fff;padding:1px 7px;margin-left:6px;vertical-align:middle}\n  .plan-foot{font-size:.84rem;color:var(--ink-soft);margin-top:14px}\n\n  /* ---------- 客户端区块 ---------- */\n  .client-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:0 44px}\n  .client-item{border-left:4px solid var(--line);padding-left:18px;margin-bottom:26px}\n  .client-item h3{font-size:1.05rem;margin-bottom:4px}\n  .client-item p{margin:0;font-size:.94rem;color:var(--ink-soft)}\n  .client-item .meta{display:block;font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;color:var(--orange-deep);font-weight:700;margin-bottom:2px}\n\n  /* ---------- FAQ 双栏 ---------- */\n  .faq-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:26px 46px}\n  .qa{border-top:1px solid var(--line);padding-top:14px}\n  .qa h3{font-size:1rem;margin-bottom:6px;display:flex;gap:10px;align-items:baseline}\n  .qa h3 .q-mark{font-size:.78rem;font-weight:800;color:var(--orange);letter-spacing:.1em;flex:0 0 auto}\n  .qa p{margin:0;font-size:.94rem;color:var(--ink-soft);padding-left:26px}\n\n  /* ---------- 使用说明 ---------- */\n  .steps{list-style:none;counter-reset:s;margin:0;padding:0}\n  .steps li{counter-increment:s;position:relative;padding:0 0 22px 54px}\n  .steps li::before{content:counter(s,decimal-leading-zero);position:absolute;left:0;top:0;font-size:1.5rem;font-weight:800;color:var(--orange);line-height:1.2}\n  .steps h3{font-size:1.02rem;margin-bottom:2px}\n  .steps p{margin:0;font-size:.94rem;color:var(--ink-soft)}\n\n  /* ---------- 结尾 ---------- */\n  .closing{background:var(--ink);color:#f4f1ec;padding:52px 0}\n  .closing h2{font-size:clamp(1.5rem,3.6vw,2rem);margin-bottom:14px;color:#fff}\n  .closing p{color:#c9c4bd;max-width:36em}\n  .closing a{color:var(--orange)}\n\n  /* ---------- 底部固定导航 ---------- */\n  nav.bottom{position:fixed;left:0;right:0;bottom:0;z-index:50;background:rgba(255,255,255,.97);border-top:2px solid var(--orange)}\n  nav.bottom .wrap{display:flex;justify-content:space-between;gap:8px;padding-top:11px;padding-bottom:11px}\n  nav.bottom a{font-size:.82rem;color:var(--ink);letter-spacing:.04em;padding:2px 0;white-space:nowrap}\n  nav.bottom a:hover{color:var(--orange);text-decoration:none}\n  nav.bottom a.brand-link{font-weight:800;letter-spacing:.18em;color:var(--orange)}\n\n  footer.colophon{font-size:.8rem;color:var(--ink-soft);padding:26px 0 40px}\n  footer.colophon p{margin:0 0 6px}\n\n  @media (min-width:640px){\n    .faq-grid{grid-template-columns:1fr 1fr}\n    .client-grid{grid-template-columns:1fr 1fr}\n    .two-col{grid-template-columns:1fr 1fr}\n    nav.bottom .wrap{justify-content:center;gap:34px}\n  }\n  @media (min-width:900px){\n    .hero-grid{grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:56px;align-items:start}\n    .hero{padding:64px 0 22px}\n    section{padding:70px 0}\n  }\n</style><header class=\"top\">\n  <div class=\"wrap\">\n    <div class=\"topline\">\n      <strong>Beeai</strong>\n      <span>订阅说明 / 第一版</span>\n    </div>\n  </div>\n  <hr class=\"rule\">\n  <div class=\"wrap hero\">\n    <div class=\"hero-grid\">\n      <div>\n        <h1>Beeai，把一条连接<em>拆开讲清楚</em></h1>\n        <p class=\"hero-lead\">订阅服务这种东西，最缺的从来不是形容词，而是可以对照的细节：一个月多少流量、几个人一起用、线路到底差在哪里、想换方案时麻不麻烦。<b>Beeai 这份说明，按时间顺序写下它被设计的过程</b>，再把三档套餐摊在同一个表格里，逐行对给你看。</p>\n        <p class=\"hero-lead\">读完大概需要六分钟。读完你不需要记住任何一句话，只需要知道自己该选哪一栏。</p>\n      </div>\n\n      <ol class=\"timeline\">\n        <li>\n          <span class=\"t-mark\">起点</span>\n          <h3>先确定要解决什么</h3>\n          <p>不是所有人都需要同样的东西。有人只想让家里的几台设备安静联网，有人要在外面处理工作文件，有人带着一整支小团队。</p>\n        </li>\n        <li>\n          <span class=\"t-mark\">分档</span>\n          <h3>把需求切成三份</h3>\n          <p>流量额度、同时在线设备数、线路类型，这三件事决定了绝大多数人的实际体验，所以套餐以它们为轴划分。</p>\n        </li>\n        <li>\n          <span class=\"t-mark\">取舍</span>\n          <h3>写清差异，不写多余的话</h3>\n          <p>高带宽节点、企业定制路由、专属客户经理，这些只出现在需要它们的档位里，不往前挪，也不往后凑。</p>\n        </li>\n        <li>\n          <span class=\"t-mark\">交付</span>\n          <h3>让你自己核对</h3>\n          <p>下面的对比表格、使用步骤与问答，都按同一套说法组织。你可以在任意一栏之间来回看，不必回头猜。</p>\n        </li>\n      </ol>\n    </div>\n  </div>\n</header>\n\n<main>\n\n  <section class=\"alt\" id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">01</span>\n        <h2>三档套餐，逐行对比</h2>\n        <p class=\"note\">价格与权益以本表为准</p>\n      </div>\n\n      <div class=\"plan-scroll\">\n        <table class=\"plans\">\n          <thead>\n            <tr>\n              <th>对比项</th>\n              <th>\n                <span class=\"plan-name\">基础版</span>\n                <span class=\"plan-price\">¥15<small> /月</small></span>\n                <span class=\"plan-year\">按年付 ¥150/年</span>\n              </th>\n              <th class=\"pick\">\n                <span class=\"plan-name\">旗舰版<span class=\"tag\">推荐</span></span>\n                <span class=\"plan-price\">¥35<small> /月</small></span>\n                <span class=\"plan-year\">按年付 ¥350/年</span>\n              </th>\n              <th>\n                <span class=\"plan-name\">团队版</span>\n                <span class=\"plan-price\">¥85<small> /月</small></span>\n                <span class=\"plan-year\">按年付 ¥850/年</span>\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>每月流量</th>\n              <td>100GB</td>\n              <td class=\"pick\">300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td class=\"pick\">5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>线路类型</th>\n              <td>普通线路节点池</td>\n              <td class=\"pick\">全节点，含 IPLC 专线游戏加速优化</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>流媒体</th>\n              <td>基础流媒体解锁</td>\n              <td class=\"pick\">全节点原生流媒体解锁</td>\n              <td>全节点原生流媒体解锁</td>\n            </tr>\n            <tr>\n              <th>路由与定制</th>\n              <td>—</td>\n              <td class=\"pick\">—</td>\n              <td>支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>支持方式</th>\n              <td>常规工单</td>\n              <td class=\"pick\">7×24 优先工单支持</td>\n              <td>专属客户经理服务</td>\n            </tr>\n            <tr>\n              <th>适合谁</th>\n              <td>个人日常上网，设备不多</td>\n              <td class=\"pick\">多设备、看流媒体、也玩游戏的人</td>\n              <td>小团队或工作室共用一份订阅</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <p class=\"plan-foot\">表格中「—」表示该档不含此项。年付价格与月付价格并列展示，选择哪一种由你按使用周期决定；实际可购渠道与结算方式请以站内说明为准。</p>\n    </div>\n  </section>\n\n  <section id=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">02</span>\n        <h2>开始使用，四步之内</h2>\n        <p class=\"note\">先读步骤，再动手</p>\n      </div>\n\n      <div class=\"two-col\">\n        <ol class=\"steps\">\n          <li>\n            <h3>对一下自己的用量</h3>\n            <p>回想上个月：几台设备同时联网、看不看剧、有没有长时间传输文件。用量落在哪一档，就先把那一档圈出来。</p>\n          </li>\n          <li>\n            <h3>数一下设备</h3>\n            <p>手机、平板、电脑、电视盒子都算一台。同时在线指的是同一时刻连着的设备数，不是注册过的设备总数。</p>\n          </li>\n          <li>\n            <h3>选定档位与周期</h3>\n            <p>三档的差异只在流量、设备数与线路，功能本身不拆开卖。月付适合先试，年付适合确定要长期用的人。</p>\n          </li>\n          <li>\n            <h3>按客户端接入</h3>\n            <p>选好档位后，在你常用的设备上完成配置。具体客户端的说明见下一块，遇到卡住的地方再翻问答区。</p>\n          </li>\n        </ol>\n\n        <div>\n          <div class=\"strip-card\">\n            <h3>关于流量的一个提醒</h3>\n            <p>流量按自然月计算，额度用完之后不会自动跳档，也不会替你升级。需要更高额度，请主动更换套餐。</p>\n          </div>\n          <div class=\"strip-card thin\">\n            <h3>关于设备数的一个提醒</h3>\n            <p>设备数限制的是同时在线数量。换设备时先断开旧的那一台，新设备就能正常接入，不必反复折腾设置。</p>\n          </div>\n          <div class=\"strip-card\">\n            <h3>关于线路的一个提醒</h3>\n            <p>基础版使用普通线路节点池；旗舰版在全部节点上可用，并对 IPLC 专线做游戏加速优化；团队版另有 VIP 高带宽节点。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"alt\" id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">03</span>\n        <h2>客户端：在哪台设备上用，就按哪种方式配</h2>\n        <p class=\"note\">以下为常见设备类型，具体安装来源以站内提供的信息为准</p>\n      </div>\n\n      <div class=\"client-grid\">\n        <div class=\"client-item\">\n          <span class=\"meta\">桌面端</span>\n          <h3>Windows 与 macOS</h3>\n          <p>在电脑上完成配置后，同一网络环境内的其他设备可一并参考同一份参数。适合长时间在线的工作场景。</p>\n        </div>\n        <div class=\"client-item\">\n          <span class=\"meta\">移动端</span>\n          <h3>iOS 与 Android</h3>\n          <p>手机是最常见的接入设备。移动端适合按需开启，外出时使用，回到固定网络后可断开以节省设备名额。</p>\n        </div>\n        <div class=\"client-item\">\n          <span class=\"meta\">大屏</span>\n          <h3>电视与电视盒子</h3>\n          <p>若你主要为了看流媒体，把大屏设备算进设备数即可。旗舰版与团队版包含全节点原生流媒体解锁。</p>\n        </div>\n        <div class=\"client-item\">\n          <span class=\"meta\">路由器</span>\n          <h3>家庭路由器</h3>\n          <p>在路由器层面统一配置，可以让家里多台设备共用一份订阅；是否支持取决于路由器本身的功能，需要你先确认。</p>\n        </div>\n      </div>\n\n      <p class=\"plan-foot\">Beeai 不在此页提供任何安装包或下载链接。客户端的具体来源、版本与配置参数，请以你购买后收到的那份说明为准。</p>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">04</span>\n        <h2>常见问题，双栏对照</h2>\n        <p class=\"note\">左栏关于套餐，右栏关于使用</p>\n      </div>\n\n      <div class=\"faq-grid\">\n        <div class=\"qa\">\n          <h3><span class=\"q-mark\">问</span>三档套餐的功能是不是不一样？</h3>\n          <p>不是拆开卖的关系。三档的差别集中在三处：每月流量、同时在线设备数、线路与节点类型。基础能力三档都有，档位越高，额度与线路条件越好。</p>\n        </div>\n        <div class=\"qa\">\n          <h3><span class=\"q-mark\">问</span>流量用完了会怎样？</h3>\n          <p>不会自动升档，也不会额外扣费。额度用完即止，等到下个自然月重新计算。如果你常在上半月就用完，说明该考虑调高一档。</p>\n        </div>\n        <div class=\"qa\">\n          <h3><span class=\"q-mark\">问</span>年付和月付怎么选？</h3>\n          <p>年付的价格写在表格里，比按月累加便宜。如果你还没想清楚用多久，先选月付；如果已经确定长期使用，年付更省事。</p>\n        </div>\n        <div class=\"qa\">\n          <h3><span class=\"q-mark\">问</span>「同时在线设备」到底怎么算？</h3>\n          <p>算的是同一时刻连着的设备台数，不是历史上注册过的设备总数。换设备时断开旧的、接入新的，就不会超出名额。</p>\n        </div>\n        <div class=\"qa\">\n          <h3><span class=\"q-mark\">问</span>旗舰版的 IPLC 专线游戏加速优化指什么？</h3>\n          <p>指对延迟敏感的实时场景做了线路层面的优化处理，属于旗舰版的线路特性之一。它不承诺某一款游戏或某一个地区的结果，实际体验仍受你所在网络环境影响。</p>\n        </div>\n        <div class=\"qa\">\n          <h3><span class=\"q-mark\">问</span>团队版可以给多人共用吗？</h3>\n          <p>可以。团队版提供 20 台同时在线设备与 VIP 专属高带宽节点，并支持企业定制路由，适合小团队或工作室把一份订阅分摊开用。</p>\n        </div>\n        <div class=\"qa\">\n          <h3><span class=\"q-mark\">问</span>流媒体解锁在哪些档位可用？</h3>\n          <p>基础版提供基础流媒体解锁；旗舰版与团队版提供全节点原生流媒体解锁。片源能否播放还取决于平台自身的策略。</p>\n        </div>\n        <div class=\"qa\">\n          <h3><span class=\"q-mark\">问</span>遇到问题找谁？</h3>\n          <p>基础版走常规工单；旗舰版是 7×24 优先工单支持；团队版配有专属客户经理。提交时把设备类型、出现问题的步骤写清楚，处理会快得多。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<section class=\"closing\">\n  <div class=\"wrap\">\n    <h2>现在，回到那张表格</h2>\n    <p>Beeai 这份说明没有别的目的：把额度、设备数、线路这三件事摆在同一行里，让你自己判断。如果还没决定，就先选月付，用一个月再回来对照。</p>\n    <p>购买入口、结算方式与最新条款以站内说明为准；本页只描述套餐内容，不代替实际页面。</p>\n  </div>\n</section>\n\n<footer class=\"colophon\">\n  <div class=\"wrap\">\n    <p>Beeai · 订阅说明</p>\n    <p>页面内容包含套餐价格、权益与常见问题；未列出的信息以官方页面为准。</p>\n  </div>\n</footer>\n\n<nav class=\"bottom\" aria-label=\"页面导航\">\n  <div class=\"wrap\">\n    <a class=\"brand-link\" href=\"#\">Beeai</a>\n    <a href=\"#plans\">套餐</a>\n    <a href=\"#howto\">使用</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#faq\">问答</a>\n  </div>\n</nav>",
